NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# Set when running behind a reverse proxy / load balancer (e.g. 1 or true)
TRUST_PROXY=

DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=true
DATABASE_LOGGING=false

REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=250

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

URL_CACHE_TTL_SECONDS=86400
